{% set home = pageKey == 'index' %}
{% set footerLicense = 'homeLicense' if home else 'legalLicense' %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title | escape }}</title>
    {% if home %}
    <meta name="description" content="{{ description | escape }}" />
    {% endif %}
    {% if pageKey != 'privacy' %}
    <meta name="theme-color" content="#0b1220" />
    {% endif %}
    {% if home %}
    <meta property="og:title" content="{{ socialTitle | escape }}" />
    <meta property="og:description" content="{{ socialDescription | escape }}" />
    <meta property="og:image" content="assets/logo.png" />
    <meta property="og:type" content="website" />
    {% endif %}
    <link rel="icon" href="assets/favicon.png" type="image/png" />
    <link rel="stylesheet" href="css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/theme-auto.css" />
    <link rel="stylesheet" href="css/site.css" />
    {% if home %}
    <script src="assets/bootstrap.min.js" defer></script>
    {% endif %}
    {% if not home %}
    <meta name="robots" content="noindex,nofollow" />
    {% endif %}
    <meta name="generator" content="Eleventy">
  </head>
  <body>
    {% include 'index.njk' if home else 'page.njk' %}
    {% include 'footer.njk' %}
  </body>
</html>
